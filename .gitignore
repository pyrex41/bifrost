# Built / vendored launcher binaries (auto-built or detected).
.bin/

# Scratch output from runs (hush-write temp files, shake artefacts).
# Anchored to repo root so it never matches the pybin/bifrost_cli package.
/scratch/
*.out
/bifrost_*/

# Kernel cache an impl may drop in cwd (e.g. shen-rust; shen-lua writes
# per-Lua-build files, .shen-kernel-cache.<hash>.bin, as of shen-lua#55).
.shen-kernel-cache*.bin
.shen-kernel-cache*.bin.tmp

# Generated KLambda artefacts (e.g. a stray shake/build output in programs/).
*.kl

# Local Claude Code session config.
.claude/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# OS
.DS_Store

# Compiled Go binary bundled into the uvx wheel at build time.
pybin/*/_bin/

# Default `go build` output (binary name == module name).
/bifrost
/bifrost_bin
